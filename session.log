191:                     "frames_with_face": len(valid), "score": 0.0}
192: 
193:         nose_positions = np.array([p[1][:2] for _, p in valid])
194:         face_scales = np.array([max(np.linalg.norm(p[33][:2] - p[263][:2]), 1e-4) for _, p in valid])
195:         frame_jitter = np.linalg.norm(np.diff(nose_positions, axis=0), axis=1)
196:         normalized_jitter = frame_jitter / face_scales[1:]
197:         position_stability = float(1.0 / (1.0 + np.std(normalized_jitter) * 50))
198: 
199:         LEFT_EYE = [33, 160, 158, 133, 153, 144]
200:         RIGHT_EYE = [263, 387, 385, 362, 380, 373]
201:         ear_sequence = []
202:         for _, pts in valid:
203:             try:
204:                 l = self._eye_aspect_ratio(pts, LEFT_EYE)
205:                 r = self._eye_aspect_ratio(pts, RIGHT_EYE)
206:                 ear_sequence.append((l + r) / 2.0)
207:             except Exception:
208:                 ear_sequence.append(0.3)
209:         ear_sequence = np.array(ear_sequence)
210: 
211:         blink_threshold = (np.mean(ear_sequence) - 0.5 * np.std(ear_sequence)) if len(ear_sequence) > 1 else 0.2
212:         below = ear_sequence < blink_threshold
213:         blink_events = int(np.sum(np.diff(below.astype(int)) == 1))
214:         analyzed_seconds = len(frames) / fps if fps > 0 else len(frames) / 24.0
215:         blink_rate = (blink_events / max(analyzed_seconds, 1e-3)) * 60.0
216:         blink_natural = NATURAL_BLINK_RATE_RANGE[0] <= blink_rate <= NATURAL_BLINK_RATE_RANGE[1]
217: 
218:         all_pts = np.array([p for _, p in valid])
219:         mean_landmark_std = float(np.mean(np.std(all_pts[:, :, :2], axis=0)))
220: 
221:         votes = [
222:             1.0 - position_stability,
223:             0.6 if not blink_natural else 0.15,
224:             float(np.clip(1.0 - mean_landmark_std / 0.004, 0.0, 1.0)),
225:         ]
226:         score = float(np.clip(np.mean(votes), 0.0, 1.0))
227: 
228:         return {
229:             "available": True,
230:             "frames_with_face": len(valid),
231:             "position_stability": round(position_stability, 3),
232:             "estimated_blink_rate_per_min": round(blink_rate, 1),
233:             "blink_rate_in_natural_range": blink_natural,
234:             "score": round(score, 3),
235:         }
236: 
237:     # ------------------------------------------------------------------
238:     def predict(self, video_path: str) -> Dict[str, Any]:
239:         if not os.path.exists(video_path):
240:             return {"error": "file_not_found", "path": video_path}
241: 
242:         cap = cv2.VideoCapture(video_path)
243:         fps = cap.get(cv2.CAP_PROP_FPS) or 24.0
244:         cap.release()
245: 
246:         frames = self._extract_frames(video_path)
247:         if not frames:
248:             return {"error": "no_frames_extracted", "path": video_path}
249: 
250:         per_frame_results = self._per_frame_forensics(frames)
251:         temporal = self._temporal_analysis(frames, fps)
252: 
253:         # --- Aggregate per-frame family scores across sampled frames.
254:         #     Use MAX, not mean: a fake is a fake even if it only shows in
255:         #     a few frames (e.g. a face-swap that glitches intermittently,
256:         #     or an edit confined to part of the timeline). ---
257:         global_scores, splice_scores, face_scores = [], [], []
258:         reasons: List[Dict[str, Any]] = []
259: 
260:         for fr in per_frame_results:
261:             if "family_scores" not in fr:
262:                 continue
263:             fs = fr["family_scores"]
264:             global_scores.append(fs.get("fully_ai_generated", 0.0))
265:             splice_scores.append(fs.get("ai_edited_region", 0.0))
266:             face_scores.append(fs.get("face_swap", 0.0))
267: 
268:             for reason in fr.get("reasons", []):
269:                 if reason.get("score", 0.0) >= 0.4 and reason.get("signal") != "none":
270:                     annotated = dict(reason)
271:                     annotated["frame_index"] = fr.get("frame_index")
272:                     reasons.append(annotated)
273: 
274:         global_score = float(np.max(global_scores)) if global_scores else 0.0
275:         splice_score = float(np.max(splice_scores)) if splice_scores else 0.0
276:         face_swap_score = float(np.max(face_scores)) if face_scores else 0.0
277:         temporal_score = temporal.get("score", 0.0) if temporal.get("available") else 0.0
278: 
279:         if temporal.get("available") and temporal_score >= TEMPORAL_FIRE_THRESHOLD:
280:             reasons.append({
281:                 "signal": "temporal_consistency", "score": temporal_score, "region": None,
282:                 "frame_index": None,
283:                 "description": (
284:                     f"Facial motion across frames is physically implausible "
285:                     f"(blink rate {temporal.get('estimated_blink_rate_per_min')}/min, "
286:                     f"natural range {NATURAL_BLINK_RATE_RANGE[0]}-{NATURAL_BLINK_RATE_RANGE[1]}; "
287:                     f"position stability {temporal.get('position_stability')})."
288:                 ),
289:             })
290: 
291:         reasons.sort(key=lambda r: r["score"], reverse=True)
292: 
293:         fired_families = []
294:         if global_score >= GLOBAL_FIRE_THRESHOLD:
295:             fired_families.append("fully_ai_generated")
296:         if splice_score >= SPLICE_FIRE_THRESHOLD:
297:             fired_families.append("ai_edited_region")
298:         if face_swap_score >= FACE_SWAP_FIRE_THRESHOLD:
299:             fired_families.append("face_swap")
300:         if temporal.get("available") and temporal_score >= TEMPORAL_FIRE_THRESHOLD:
301:             fired_families.append("temporal_inconsistency")
302: 
303:         overall_score = max(global_score, splice_score, face_swap_score, temporal_score)
304: 
305:         if fired_families:
306:             label = "FAKE"
307:             confidence = 50.0 + min(overall_score, 1.0) * 50.0
308:         elif not per_frame_results and not temporal.get("available"):
309:             label = "UNCERTAIN"
310:             confidence = 0.0
311:         else:
312:             label = "AUTHENTIC"
313:             confidence = 50.0 + (1.0 - overall_score) * 50.0
314: 
315:         if not reasons:
316:             reasons = [{
317:                 "signal": "none", "score": 0.0, "region": None, "frame_index": None,
318:                 "description": "No manipulation signal crossed its detection threshold in any sampled frame."
319:             }]
320: 
321:         notes = []
322:         if self._image_detector is None:
323:             notes.append("Per-frame image forensics unavailable; relying on temporal analysis only.")
324:         if not temporal.get("available"):
325:             notes.append(f"Temporal analysis unavailable: {temporal.get('reason', 'unknown')}.")
326: 
327:         verdict = VideoVerdict(
328:             label=label,
329:             fake_type=fired_families,
330:             confidence=confidence,
331:             reasons=reasons,
332:             family_scores={
333:                 "fully_ai_generated": round(global_score, 3),
334:                 "ai_edited_region": round(splice_score, 3),
335:                 "face_swap": round(face_swap_score, 3),
336:                 "temporal_inconsistency": round(temporal_score, 3),
337:                 "temporal_details": temporal,
338:             },
339:             frames_analyzed=len(frames),
340:             notes=" ".join(notes) if notes else
341:                   f"Full forensics run on {len(per_frame_results)} sampled frames; "
342:                   f"temporal analysis across {len(frames)} frames.",
343:         )
344:         return verdict.to_dict()
345: 
346: 
347: final_video_detector = FinalVideoDetector()
348: 
349: 
350: if __name__ == "__main__":
351:     import sys
352:     import json
353:     if len(sys.argv) < 2:
354:         print("Usage: python final_video_detector.py <video_path>")
355:         sys.exit(1)
356:     print(json.dumps(final_video_detector.predict(sys.argv[1]), indent=2))

