323: # Offline training script template for Strategy B
324: # ------------------------------------------------------------------
325: def train_from_dataset(
326:     bonafide_dir: str,
327:     spoof_dir: str,
328:     output_path: str = "models/audio_rf_classifier.pkl",
329: ):
330:     """
331:     Train a lightweight RandomForest on the acoustic features above.
332: 
333:     Expected layout:
334:         bonafide_dir/  -- folder of real/bonafide .wav or .flac files
335:         spoof_dir/     -- folder of synthetic/spoofed .wav or .flac files
336: 
337:     For ASVspoof 2019 LA: bonafide_dir = .../ASVspoof2019_LA_train/bonafide,
338:     spoof_dir = .../ASVspoof2019_LA_train/spoof (after sorting by the
339:     protocol file's label column -- ASVspoof ships flat directories with
340:     a separate label/protocol text file, so you'll need to split files
341:     into these two folders first based on that protocol file).
342: 
343:     Usage:
344:         from final_audio_detector import train_from_dataset
345:         train_from_dataset("data/bonafide", "data/spoof")
346:     """
347:     from sklearn.ensemble import RandomForestClassifier
348:     from sklearn.model_selection import train_test_split
349:     from sklearn.metrics import classification_report
350: 
351:     detector = FinalAudioDetector()
352:     X, y = [], []
353: 
354:     for label, folder in [(0, bonafide_dir), (1, spoof_dir)]:
355:         for fname in os.listdir(folder):
356:             if not fname.lower().endswith((".wav", ".flac", ".mp3")):
357:                 continue
358:             path = os.path.join(folder, fname)
359:             feats = detector.extract_training_features(path)
