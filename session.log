100:     # ------------------------------------------------------------------
101:     def _extract_frames(self, video_path: str, max_frames: int = MAX_FRAMES_SAMPLED) -> List[np.ndarray]:
102:         cap = cv2.VideoCapture(video_path)
103:         total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
104:         if total <= 0:
105:             return []
106: 
107:         step = max(1, total // max_frames)
108: 
109:         frames = []
110:         for i in range(max_frames):
111:             target_frame = i * step
112:             if target_frame >= total:
113:                 break
114:             cap.set(cv2.CAP_PROP_POS_FRAMES, target_frame)
115:             ret, frame = cap.read()
116:             if not ret:
117:                 break
118:             frames.append(frame)
