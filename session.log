70:     notes: str = ""
71: 
72:     def to_dict(self) -> Dict[str, Any]:
73:         return {
74:             "label": self.label,
75:             "confidence": round(self.confidence, 2),
76:             "ai_probability": round(self.ai_probability, 4),
77:             "perplexity_signal": round(self.perplexity_signal, 4) if self.perplexity_signal is not None else None,
78:             "pattern_signal": round(self.pattern_signal, 4),
79:             "metrics": self.metrics,
80:             "notes": self.notes,
81:         }
82: 
83: 
84: class FinalTextDetector:
85:     def __init__(self):
86:         self._tokenizer = None
87:         self._model = None
88:         self._load_error: Optional[str] = None
89:         self._load_probe_model()
90: 
91:         # Kept intentionally short and labeled as weak/stylistic. These are
92:         # NOT used to make a confident call on their own.
93:         self._style_patterns = [
94:             r"\bas an ai\b", r"\bas a language model\b", r"\bi cannot\b",
95:             r"\bit is important to note that\b", r"\bit'?s worth noting that\b",
96:             r"\bin conclusion\b", r"\bto summarize\b",
97:         ]
98: 
99:     # ------------------------------------------------------------------
100:     def _load_probe_model(self):
101:         try:
102:             import torch
103:             from transformers import GPT2LMHeadModel, GPT2TokenizerFast
104:             self._torch = torch
105:             self._tokenizer = GPT2TokenizerFast.from_pretrained(PROBE_MODEL_ID)
106:             self._model = GPT2LMHeadModel.from_pretrained(PROBE_MODEL_ID)
107:             self._model.eval()
108:             logger.info("Loaded probe LM for perplexity scoring: %s", PROBE_MODEL_ID)
109:         except Exception as e:
110:             self._load_error = str(e)
111:             logger.warning("Could not load probe LM (%s). Falling back to pattern-only mode "
112:                             "with suppressed confidence.", e)
113: 
114:     # ------------------------------------------------------------------
115:     # Perplexity + burstiness (primary signal)
116:     # ------------------------------------------------------------------
117:     def _perplexity_and_burstiness(self, text: str) -> Optional[Dict[str, float]]:
118:         if self._model is None or self._tokenizer is None:
119:             return None
120:         try:
121:             torch = self._torch
122:             encodings = self._tokenizer(text, return_tensors="pt", truncation=True, max_length=1024)
123:             input_ids = encodings.input_ids
124: 
125:             if input_ids.shape[1] < 8:
126:                 return None
127: 
128:             with torch.no_grad():
129:                 outputs = self._model(input_ids, labels=input_ids)
130:                 # outputs.loss is mean per-token cross-entropy (natural log).
131:                 # We also want PER-TOKEN losses (not just the mean) to
132:                 # compute burstiness -- the variance of surprise across
133:                 # the sequence, not just its average.
134:                 logits = outputs.logits[:, :-1, :]
135:                 targets = input_ids[:, 1:]
136:                 log_probs = torch.nn.functional.log_softmax(logits, dim=-1)
137:                 token_log_probs = log_probs.gather(2, targets.unsqueeze(-1)).squeeze(-1)
138:                 token_nll = -token_log_probs.squeeze(0).numpy()  # per-token negative log-likelihood
139: 
140:             mean_nll = float(np.mean(token_nll))
141:             perplexity = float(np.exp(np.clip(mean_nll, 0, 20)))
142:             # Burstiness: std of per-token surprise. AI text tends to stay
143:             # in a narrower band (lower std); human text swings between
144:             # very predictable and very surprising tokens more (higher std).
145:             burstiness = float(np.std(token_nll))
146: 
147:             return {
148:                 "perplexity": perplexity,
149:                 "mean_nll": mean_nll,
150:                 "burstiness": burstiness,
151:                 "tokens_scored": int(len(token_nll)),
152:             }
153:         except Exception as e:
154:             logger.error("Perplexity scoring failed: %s", e)
155:             return None
156: 
157:     def _perplexity_to_ai_score(self, metrics: Dict[str, float]) -> float:
158:         """
159:         Maps (perplexity, burstiness) to an AI-likelihood in [0,1].
160: 
161:         IMPORTANT CALIBRATION NOTE: the thresholds below (perplexity ~20-60
162:         "typical for human text" / burstiness ~2.5+ "typical human variance")
163:         are reasonable starting points from published perplexity-detection
164:         literature using GPT-2 as a probe, but they are NOT fit on your
165:         specific text domain. Before trusting this in production, run it
166:         against a labeled set of human vs. AI text samples from YOUR
167:         use case (emails, essays, social posts -- perplexity baselines
168:         differ by genre) and adjust PPL_LOW/PPL_HIGH/BURST_LOW below, or
169:         better: replace this hand-tuned mapping with a logistic regression
170:         fit on (perplexity, burstiness) -> label from labeled data. That
171:         is a 10-line sklearn script once you have ~200 labeled examples.
172:         """
173:         ppl = metrics["perplexity"]
174:         burst = metrics["burstiness"]
175: 
176:         # Low perplexity (model finds text very predictable) -> AI-leaning.
177:         PPL_LOW, PPL_HIGH = 15.0, 55.0
178:         ppl_score = 1.0 - np.clip((ppl - PPL_LOW) / (PPL_HIGH - PPL_LOW), 0.0, 1.0)
179: 
180:         # Low burstiness (uniform surprise across the text) -> AI-leaning.
181:         BURST_LOW, BURST_HIGH = 1.5, 4.0
182:         burst_score = 1.0 - np.clip((burst - BURST_LOW) / (BURST_HIGH - BURST_LOW), 0.0, 1.0)
183: 
184:         return float(np.clip(0.5 * ppl_score + 0.5 * burst_score, 0.0, 1.0))
185: 
186:     # ------------------------------------------------------------------
187:     # Stylistic pattern signal (weak, corroborating only)
188:     # ------------------------------------------------------------------
189:     def _pattern_signal(self, text: str) -> Dict[str, Any]:
190:         lower = text.lower()
191:         matches = sum(len(re.findall(p, lower)) for p in self._style_patterns)
192: 
193:         words = text.split()
194:         word_count = max(len(words), 1)
195: 
196:         # Repetitive n-grams: a real but weak signal -- some AI text
197:         # repeats phrase structures more than natural human writing,
198:         # though this is also genre-dependent (technical docs repeat
199:         # phrases naturally too).
200:         trigrams = list(zip(words, words[1:], words[2:])) if len(words) > 2 else []
201:         trigram_counts = Counter(trigrams)
202:         repeated_trigrams = sum(1 for c in trigram_counts.values() if c > 1)
203:         repetition_ratio = repeated_trigrams / max(len(trigrams), 1)
204: 
205:         normalized_matches = min(1.0, matches / max(word_count / 150, 1))
206:         score = float(np.clip(0.6 * normalized_matches + 0.4 * min(1.0, repetition_ratio * 5), 0.0, 1.0))
207: 
208:         return {
209:             "score": score,
210:             "phrase_matches": matches,
211:             "repetition_ratio": round(repetition_ratio, 3),
212:             "caveat": "Weak, genre-dependent signal. Formal/academic writing and "
213:                       "non-native English writers can score elevated here without "
214:                       "being AI-generated. Do not treat this alone as evidence.",
215:         }
216: 
217:     # ------------------------------------------------------------------
218:     # Public API
219:     # ------------------------------------------------------------------
220:     def predict(self, text: str) -> Dict[str, Any]:
221:         if not text or not text.strip():
222:             return {"error": "empty_text"}
223: 
224:         word_count = len(text.split())
225:         ppl_metrics = self._perplexity_and_burstiness(text)
226:         pattern_info = self._pattern_signal(text)
227:         pattern_signal = pattern_info["score"]
228: 
229:         if ppl_metrics is not None:
230:             perplexity_signal = self._perplexity_to_ai_score(ppl_metrics)
231:             ai_probability = PERPLEXITY_WEIGHT * perplexity_signal + PATTERN_WEIGHT * pattern_signal
232:             notes = "Combined perplexity/burstiness (primary) + stylistic patterns (weak, corroborating)."
233:         else:
234:             perplexity_signal = None
235:             ai_probability = pattern_signal
236:             notes = (f"Probe LM unavailable ({self._load_error}); running on weak stylistic "
237:                      f"patterns only. Confidence is deliberately suppressed -- this mode is "
238:                      f"not reliable enough to act on alone.")
239: 
240:         if word_count < MIN_WORDS_FOR_RELIABLE_SCORE:
241:             notes += f" Text is short ({word_count} words); perplexity estimates are noisy below ~{MIN_WORDS_FOR_RELIABLE_SCORE} words."
242: 
243:         ai_probability = float(np.clip(ai_probability, 0.0, 1.0))
244:         distance_from_mid = abs(ai_probability - 0.5) * 2
245: 
246:         if ppl_metrics is None:
247:             distance_from_mid *= 0.4  # pattern-only mode: suppress confidence hard
248:         if word_count < MIN_WORDS_FOR_RELIABLE_SCORE:
249:             distance_from_mid *= 0.6
250: 
251:         if distance_from_mid < (1 - LOW_CONFIDENCE_THRESHOLD):
252:             label = "UNCERTAIN"
253:         elif ai_probability > 0.5:
254:             label = "AI_GENERATED"
255:         else:
256:             label = "HUMAN_WRITTEN"
257: 
258:         confidence = 50.0 + distance_from_mid * 50.0
259: 
260:         metrics = {"word_count": word_count, "pattern_details": pattern_info}
261:         if ppl_metrics is not None:
262:             metrics["perplexity_details"] = {k: round(v, 3) if isinstance(v, float) else v
263:                                               for k, v in ppl_metrics.items()}
264: 
265:         verdict = TextVerdict(
266:             label=label,
267:             confidence=confidence,
268:             ai_probability=ai_probability,
269:             perplexity_signal=perplexity_signal,
270:             pattern_signal=pattern_signal,
271:             metrics=metrics,
272:             notes=notes,
273:         )
274:         return verdict.to_dict()
275: 
276: 
277: # Global instance
278: final_text_detector = FinalTextDetector()
