102:     def _model_predict(self, image_path: str) -> Optional[float]:
103:         if self._pipeline is None:
104:             return None
105:         try:
106:             image = Image.open(image_path).convert("RGB")
107:             results = self._pipeline(image)
108:             ai_score = 0.0
109:             for r in results:
110:                 label = r["label"].lower()
111:                 if any(k in label for k in ("fake", "ai", "synthetic", "generated", "artificial")):
112:                     ai_score = max(ai_score, r["score"])
113:                 elif any(k in label for k in ("real", "human", "authentic", "natural")):
114:                     ai_score = max(ai_score, 1.0 - r["score"])
115:             return float(ai_score)
116:         except Exception as e:
117:             logger.error("Model inference failed: %s", e)
118:             return None
119: 
120:     # ------------------------------------------------------------------
121:     def predict(self, image_path: str) -> Dict[str, Any]:
122:         if not os.path.exists(image_path):
