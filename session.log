55: # ======================================================================
56: # 1. GLOBAL AI-GENERATION FORENSICS
57: # ======================================================================
58: 
59: def fft_periodicity_score(gray: np.ndarray) -> Finding:
60:     """
61:     GAN/diffusion upsampling layers often leave faint, regularly-spaced
62:     peaks in the frequency domain. We measure bumpiness of the radial
63:     energy falloff curve; natural photos fall off smoothly, synthetic
64:     upsampling introduces small periodic bumps.
65:     """
66:     try:
67:         f = np.fft.fft2(gray.astype(np.float32))
68:         fshift = np.fft.fftshift(f)
69:         magnitude = np.log(np.abs(fshift) + 1)
70: 
71:         h, w = magnitude.shape
72:         cy, cx = h // 2, w // 2
73:         y, x = np.ogrid[:h, :w]
74:         r = np.sqrt((x - cx) ** 2 + (y - cy) ** 2).astype(int)
75: 
76:         max_r = min(cy, cx)
77:         ring_means = []
78:         for radius in range(5, max_r, 5):
79:             mask = (r >= radius - 2) & (r < radius + 2)
80:             vals = magnitude[mask]
81:             if vals.size > 0:
82:                 ring_means.append(float(np.mean(vals)))
83: 
84:         if len(ring_means) < 4:
85:             return make_finding("fft_periodicity", 0.0, "Image too small for reliable frequency analysis.")
86: 
87:         ring_means = np.array(ring_means)
88:         second_deriv = np.diff(ring_means, n=2)
89:         bumpiness = float(np.std(second_deriv)) / (float(np.mean(np.abs(ring_means))) + 1e-6)
90:         score = float(np.clip(bumpiness / 0.15, 0.0, 1.0))
91: 
92:         desc = ("Frequency spectrum shows periodic bumps consistent with generative upsampling."
93:                 if score > 0.5 else "Frequency spectrum falloff is smooth, consistent with natural capture.")
94:         return make_finding("fft_periodicity", score, desc)
95:     except Exception as e:
96:         logger.error("fft_periodicity_score failed: %s", e)
97:         return make_finding("fft_periodicity", 0.0, "Analysis failed.")
98: 
99: 
100: def texture_uniformity_score(gray: np.ndarray) -> Finding:
101:     """
102:     Real photographs have naturally varying local texture across the frame
103:     (focus falloff, sensor noise). Generative models often produce
104:     unnaturally uniform texture statistics. We measure the coefficient of
105:     variation of local variance across a region grid -- LOW variation is
106:     the suspicious direction.
107:     """
108:     try:
109:         h, w = gray.shape
110:         rh, rw = h // 6, w // 6
111:         if rh < 8 or rw < 8:
112:             return make_finding("texture_uniformity", 0.0, "Image too small for texture grid analysis.")
113: 
114:         local_vars = []
115:         for i in range(0, h - rh, rh):
116:             for j in range(0, w - rw, rw):
117:                 region = gray[i:i + rh, j:j + rw]
118:                 local_vars.append(float(np.var(region)))
119: 
120:         if len(local_vars) < 4:
121:             return make_finding("texture_uniformity", 0.0, "Insufficient regions for analysis.")
122: 
123:         mean_v = np.mean(local_vars)
124:         cv = np.std(local_vars) / mean_v if mean_v > 1e-6 else 0.0
125:         score = float(1.0 - np.clip(cv / 1.2, 0.0, 1.0))
126: 
127:         desc = ("Texture detail is unusually uniform across the frame, a known generative-model signature."
128:                 if score > 0.5 else "Texture detail varies naturally across the frame.")
129:         return make_finding("texture_uniformity", score, desc)
130:     except Exception as e:
131:         logger.error("texture_uniformity_score failed: %s", e)
132:         return make_finding("texture_uniformity", 0.0, "Analysis failed.")
133: 
134: 
135: def histogram_smoothness_score(img: np.ndarray) -> Finding:
136:     """
137:     Real-world sensor noise gives color histograms a jagged profile.
138:     Over-smooth histograms (common after diffusion-model decoding, which
139:     lacks true sensor noise) score higher here.
140:     """
141:     try:
142:         scores = []
143:         for ch in range(3):
144:             hist = cv2.calcHist([img], [ch], None, [256], [0, 256]).flatten()
145:             if hist.sum() == 0:
146:                 continue
147:             hist = hist / hist.sum()
148:             second_deriv = np.diff(hist, n=2)
149:             flatness = float(np.mean(np.abs(second_deriv) < 1e-5))
150:             scores.append(flatness)
151:         if not scores:
152:             return make_finding("histogram_smoothness", 0.0, "Could not compute histograms.")
153:         score = float(np.clip(np.mean(scores) * 1.5, 0.0, 1.0))
154:         desc = ("Color histograms are unusually smooth, lacking typical sensor noise texture."
155:                 if score > 0.5 else "Color histograms show natural sensor-noise texture.")
156:         return make_finding("histogram_smoothness", score, desc)
157:     except Exception as e:
158:         logger.error("histogram_smoothness_score failed: %s", e)
159:         return make_finding("histogram_smoothness", 0.0, "Analysis failed.")
160: 
161: 
162: # ======================================================================
163: # 2. SPLICE / LOCALIZED EDIT FORENSICS
164: # ======================================================================
165: 
166: def error_level_analysis(img_path: str, quality: int = 90) -> Finding:
167:     """
168:     Error Level Analysis: re-save the image at a known JPEG quality and
169:     diff against the original. Regions that were edited/composited AFTER
170:     the image's last save tend to have a different recompression error
171:     signature than the rest of the (already-compressed) image, showing up
172:     as a brighter/different region in the ELA diff.
173: 
174:     This is a real, decades-old forensic technique (its main weakness is
175:     false positives on already-low-quality or PNG-source images, which is
176:     why it's one signal among several here, not a standalone verdict).
177:     """
178:     try:
179:         img = cv2.imread(img_path)
180:         if img is None:
181:             return make_finding("error_level_analysis", 0.0, "Could not read image.")
182: 
183:         ok, encoded = cv2.imencode(".jpg", img, [cv2.IMWRITE_JPEG_QUALITY, quality])
184:         if not ok:
185:             return make_finding("error_level_analysis", 0.0, "Re-encoding failed.")
186:         resaved = cv2.imdecode(encoded, cv2.IMREAD_COLOR)
187: 
188:         diff = cv2.absdiff(img, resaved).astype(np.float32)
189:         diff_gray = cv2.cvtColor(diff.astype(np.uint8), cv2.COLOR_BGR2GRAY).astype(np.float32)
190: 
191:         h, w = diff_gray.shape
192:         gh, gw = max(h // 8, 1), max(w // 8, 1)
193:         cell_means = []
194:         cell_boxes = []
195:         for i in range(0, h - gh + 1, gh):
196:             for j in range(0, w - gw + 1, gw):
197:                 cell = diff_gray[i:i + gh, j:j + gw]
198:                 cell_means.append(float(np.mean(cell)))
199:                 cell_boxes.append((j, i, gw, gh))
200: 
201:         if len(cell_means) < 4:
202:             return make_finding("error_level_analysis", 0.0, "Image too small for ELA grid.")
203: 
204:         cell_means = np.array(cell_means)
205:         mean_err = np.mean(cell_means)
206:         std_err = np.std(cell_means)
207: 
208:         if std_err < 1e-6:
209:             return make_finding("error_level_analysis", 0.0, "Uniform compression error across frame; no localized anomaly.")
210: 
211:         # Cells with error level far from the global mean suggest a region
212:         # was edited/composited separately from the rest of the image.
213:         z_scores = (cell_means - mean_err) / std_err
214:         worst_idx = int(np.argmax(np.abs(z_scores)))
215:         worst_z = float(np.abs(z_scores[worst_idx]))
216: 
217:         score = float(np.clip((worst_z - 1.5) / 3.0, 0.0, 1.0))
218:         region = cell_boxes[worst_idx] if score > 0.3 else None
219: 
220:         desc = (f"Localized recompression-error anomaly detected (region stands out {worst_z:.1f} std "
221:                 f"from the rest of the frame), consistent with a spliced or AI-edited region."
222:                 if score > 0.3 else
223:                 "No significant localized compression-error anomaly detected.")
224:         return make_finding("error_level_analysis", score, desc, region=region)
225:     except Exception as e:
226:         logger.error("error_level_analysis failed: %s", e)
227:         return make_finding("error_level_analysis", 0.0, "Analysis failed.")
228: 
229: 
230: def noise_residual_consistency(gray: np.ndarray) -> Finding:
231:     """
232:     Camera sensor noise (PRNU-like residual) is statistically consistent
233:     across an authentic, untouched photo. A composited/AI-generated region
234:     pasted into an otherwise-real photo typically has a different noise
235:     fingerprint than its surroundings. We extract a high-frequency noise
236:     residual (image minus a denoised version of itself) and compare its
237:     local variance across a region grid -- looking for one region that's
238:     a statistical outlier relative to the rest, not just generally noisy.
239:     """
240:     try:
241:         denoised = cv2.medianBlur(gray, 5)
242:         residual = gray.astype(np.float32) - denoised.astype(np.float32)
243: 
244:         h, w = residual.shape
245:         gh, gw = max(h // 6, 1), max(w // 6, 1)
246:         cell_vars = []
247:         cell_boxes = []
248:         for i in range(0, h - gh + 1, gh):
249:             for j in range(0, w - gw + 1, gw):
250:                 cell = residual[i:i + gh, j:j + gw]
251:                 cell_vars.append(float(np.var(cell)))
252:                 cell_boxes.append((j, i, gw, gh))
253: 
254:         if len(cell_vars) < 4:
255:             return make_finding("noise_residual_consistency", 0.0, "Image too small for noise-grid analysis.")
256: 
257:         cell_vars = np.array(cell_vars)
258:         mean_v, std_v = np.mean(cell_vars), np.std(cell_vars)
259:         if std_v < 1e-6 or mean_v < 1e-6:
260:             return make_finding("noise_residual_consistency", 0.0, "Noise pattern uniform across frame.")
261: 
262:         z_scores = (cell_vars - mean_v) / std_v
263:         worst_idx = int(np.argmax(np.abs(z_scores)))
264:         worst_z = float(np.abs(z_scores[worst_idx]))
265: 
266:         score = float(np.clip((worst_z - 1.5) / 3.0, 0.0, 1.0))
267:         region = cell_boxes[worst_idx] if score > 0.3 else None
268: 
269:         desc = (f"One region's noise statistics deviate sharply ({worst_z:.1f} std) from the rest of the "
270:                 f"frame, consistent with a composited or AI-edited region."
271:                 if score > 0.3 else
272:                 "Noise statistics are consistent across the frame.")
273:         return make_finding("noise_residual_consistency", score, desc, region=region)
274:     except Exception as e:
275:         logger.error("noise_residual_consistency failed: %s", e)
276:         return make_finding("noise_residual_consistency", 0.0, "Analysis failed.")
277: 
278: 
279: # ======================================================================
280: # 3. FACE-REGION / FACE-SWAP FORENSICS (per detected face)
281: # ======================================================================
282: 
283: def detect_faces(img: np.ndarray) -> List[Dict[str, Any]]:
284:     """
285:     Multi-face, angle/occlusion-robust detection using RetinaFace.
286:     Returns list of {"box": (x,y,w,h), "landmarks": {...}, "confidence": float}.
287:     Falls back to OpenCV Haar cascade (frontal-only, weaker) if RetinaFace
288:     is unavailable, clearly flagged in the result.
289:     """
290:     try:
291:         from retinaface import RetinaFace
292:         # RetinaFace expects RGB
293:         rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
294:         detections = RetinaFace.detect_faces(rgb)
295:         faces = []
296:         if isinstance(detections, dict):
297:             for _, d in detections.items():
298:                 x1, y1, x2, y2 = d["facial_area"]
299:                 faces.append({
300:                     "box": (int(x1), int(y1), int(x2 - x1), int(y2 - y1)),
301:                     "landmarks": d.get("landmarks", {}),
302:                     "confidence": float(d.get("score", 1.0)),
303:                     "detector": "retinaface",
304:                 })
305:         return faces
306:     except Exception as e:
307:         logger.warning("RetinaFace unavailable (%s), falling back to Haar cascade "
308:                         "(frontal-only, less robust to angle/occlusion).", e)
309:         try:
310:             gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
311:             cascade = cv2.CascadeClassifier(cv2.data.haarcascades + "haarcascade_frontalface_default.xml")
312:             boxes = cascade.detectMultiScale(gray, 1.1, 4)
313:             return [{"box": tuple(int(v) for v in b), "landmarks": {}, "confidence": 0.5,
314:                       "detector": "haar_fallback"} for b in boxes]
315:         except Exception as e2:
316:             logger.error("Face detection completely failed: %s", e2)
317:             return []
318: 
319: 
320: def face_blend_boundary_score(img: np.ndarray, box: Tuple[int, int, int, int]) -> Finding:
321:     """
322:     Face-swap compositing typically blends a synthesized/warped face into
323:     the target frame along a boundary (jawline, hairline, forehead). This
324:     blend seam often has different edge/gradient statistics than a natural
325:     face-to-background transition, even after blurring to hide it.
326:     We compare gradient-magnitude statistics in a thin ring just inside vs.
327:     just outside the detected face box.
328:     """
329:     try:
330:         x, y, w, h = box
331:         H, W = img.shape[:2]
332:         pad = max(int(0.15 * max(w, h)), 5)
333: 
334:         # Ring just outside the face box (background side of the boundary)
335:         x0o, y0o = max(x - pad, 0), max(y - pad, 0)
336:         x1o, y1o = min(x + w + pad, W), min(y + h + pad, H)
337:         outer = img[y0o:y1o, x0o:x1o]
338: 
339:         # The face region itself (inside the boundary)
340:         x0i, y0i = max(x, 0), max(y, 0)
341:         x1i, y1i = min(x + w, W), min(y + h, H)
342:         inner = img[y0i:y1i, x0i:x1i]
343: 
344:         if inner.size == 0 or outer.size == 0:
345:             return make_finding("face_blend_boundary", 0.0, "Face region too small/at edge of frame to analyze.", region=box)
346: 
347:         inner_gray = cv2.cvtColor(inner, cv2.COLOR_BGR2GRAY)
348:         outer_gray = cv2.cvtColor(outer, cv2.COLOR_BGR2GRAY)
349: 
350:         inner_lap_var = float(cv2.Laplacian(inner_gray, cv2.CV_64F).var())
351:         outer_lap_var = float(cv2.Laplacian(outer_gray, cv2.CV_64F).var())
352: 
353:         # A natural face-to-background transition usually has comparable
354:         # sharpness statistics; a sharp mismatch (especially face notably
355:         # SMOOTHER than its surroundings -- a common swap-blending artifact)
356:         # is the suspicious direction.
357:         if outer_lap_var < 1e-6:
358:             ratio = 1.0
359:         else:
360:             ratio = inner_lap_var / outer_lap_var
361: 
362:         # ratio << 1 means face is much smoother than its surroundings.
363:         score = float(np.clip((0.6 - ratio) / 0.6, 0.0, 1.0)) if ratio < 0.6 else 0.0
364: 
365:         desc = (f"Face region is markedly smoother than surrounding image (sharpness ratio {ratio:.2f}), "
366:                 f"consistent with a blended/composited face."
367:                 if score > 0.3 else
368:                 "Face region sharpness is consistent with its surroundings.")
369:         return make_finding("face_blend_boundary", score, desc, region=box)
370:     except Exception as e:
371:         logger.error("face_blend_boundary_score failed: %s", e)
372:         return make_finding("face_blend_boundary", 0.0, "Analysis failed.", region=box)
373: 
374: 
375: def face_noise_mismatch_score(img: np.ndarray, box: Tuple[int, int, int, int]) -> Finding:
376:     """
377:     Same noise-residual principle as noise_residual_consistency(), but
378:     specifically comparing the face region against its immediate
379:     surrounding background -- the most common splice boundary in a
380:     face-swap. A different source image/generator for the face will often
381:     leave a distinct noise fingerprint vs. the rest of the (real) frame.
382:     """
383:     try:
384:         x, y, w, h = box
385:         H, W = img.shape[:2]
386:         pad = max(int(0.4 * max(w, h)), 10)
387: 
388:         x0o, y0o = max(x - pad, 0), max(y - pad, 0)
389:         x1o, y1o = min(x + w + pad, W), min(y + h + pad, H)
390:         outer_region = img[y0o:y1o, x0o:x1o].copy()
391: 
392:         # Mask out the face itself from the outer region so we're comparing
393:         # face-noise vs. pure-background-noise, not face vs. (face+background).
394:         fx0, fy0 = x - x0o, y - y0o
395:         fx1, fy1 = min(fx0 + w, outer_region.shape[1]), min(fy0 + h, outer_region.shape[0])
396:         mask = np.ones(outer_region.shape[:2], dtype=bool)
397:         if fx0 >= 0 and fy0 >= 0 and fx1 > fx0 and fy1 > fy0:
398:             mask[max(fy0, 0):fy1, max(fx0, 0):fx1] = False
399: 
400:         outer_gray = cv2.cvtColor(outer_region, cv2.COLOR_BGR2GRAY)
401:         bg_pixels = outer_gray[mask]
402: 
403:         face_region = img[max(y, 0):min(y + h, H), max(x, 0):min(x + w, W)]
404:         if face_region.size == 0 or bg_pixels.size < 50:
405:             return make_finding("face_noise_mismatch", 0.0, "Insufficient background context to compare.", region=box)
406:         face_gray = cv2.cvtColor(face_region, cv2.COLOR_BGR2GRAY)
407: 
408:         def noise_energy(patch_1d_or_2d):
409:             arr = patch_1d_or_2d.astype(np.float32)
410:             if arr.ndim == 1:
411:                 return float(np.var(arr))
412:             denoised = cv2.medianBlur(arr.astype(np.uint8), 3).astype(np.float32)
413:             return float(np.var(arr - denoised))
414: 
415:         face_noise = noise_energy(face_gray)
416:         bg_noise = noise_energy(bg_pixels)
417: 
418:         if bg_noise < 1e-6:
419:             ratio = 1.0
420:         else:
421:             ratio = face_noise / bg_noise
422: 
423:         # Either much higher or much lower noise energy than the surrounding
424:         # background is suspicious -- different capture/generation source.
425:         deviation = abs(np.log(max(ratio, 1e-3)))
426:         score = float(np.clip((deviation - 0.3) / 1.2, 0.0, 1.0))
427: 
428:         desc = (f"Face noise pattern differs substantially from surrounding background (ratio {ratio:.2f}), "
429:                 f"consistent with the face originating from a different image/generation source."
430:                 if score > 0.3 else
431:                 "Face noise pattern is consistent with the surrounding background.")
432:         return make_finding("face_noise_mismatch", score, desc, region=box)
433:     except Exception as e:
434:         logger.error("face_noise_mismatch_score failed: %s", e)
435:         return make_finding("face_noise_mismatch", 0.0, "Analysis failed.", region=box)
436: 
437: 
438: def analyze_face_region(img: np.ndarray, face: Dict[str, Any]) -> Dict[str, Any]:
439:     """Run all per-face forensic checks on one detected face and combine them."""
440:     box = face["box"]
441:     findings = [
442:         face_blend_boundary_score(img, box),
443:         face_noise_mismatch_score(img, box),
444:     ]
445:     score = float(np.mean([f["score"] for f in findings]))
446:     return {
447:         "box": box,
448:         "detector": face.get("detector", "unknown"),
449:         "detection_confidence": face.get("confidence", None),
450:         "face_swap_score": round(score, 3),
451:         "findings": findings,
452:     }
453: 
454: 
455: # ======================================================================
456: # Orchestration helper: run everything, return ranked findings
457: # ======================================================================
458: 
459: def full_image_forensics(img_path: str) -> Dict[str, Any]:
460:     """
461:     Runs all three forensic families on a single image and returns:
462:       - global_findings: list of Finding (whole-frame AI-generation signals)
463:       - splice_findings: list of Finding (localized edit signals)
464:       - face_analyses: list of per-face dicts (face-swap signals, one per detected face)
465:     Caller (final_image_detector.py) combines these into a verdict + reasons.
466:     """
467:     img = cv2.imread(img_path)
468:     if img is None:
469:         return {"error": "could_not_read_image"}
470: 
471:     gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
472: 
473:     global_findings = [
474:         fft_periodicity_score(gray),
475:         texture_uniformity_score(gray),
476:         histogram_smoothness_score(img),
477:     ]
478:     splice_findings = [
479:         error_level_analysis(img_path),
480:         noise_residual_consistency(gray),
481:     ]
482: 
483:     faces = detect_faces(img)
484:     face_analyses = [analyze_face_region(img, f) for f in faces]
485: 
486:     return {
487:         "global_findings": global_findings,
488:         "splice_findings": splice_findings,
489:         "face_analyses": face_analyses,
490:         "faces_detected": len(faces),
491:     }

