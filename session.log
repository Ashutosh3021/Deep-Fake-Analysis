219:                 # If both fail, create a mock implementation
220:                 print("WARNING: MediaPipe face mesh not available. Temporal analysis will use fallback.")
221:                 print("Error details:", traceback.format_exc())
222:                 self.use_new_api = False
223:                 self.mp_face_mesh = None
224:                 self.face_mesh = None
225:     
226:     def extract_facial_landmarks(self, frame: np.ndarray) -> np.ndarray:
227:         """Extract facial landmarks from frame"""
228:         if self.use_new_api:
229:             # Handle newer mediapipe API
230:             try:
231:                 # For now, return a fallback since we don't have the actual model file
232:                 return np.zeros(478 * 3)  # 478 landmarks * 3 coordinates
233:             except Exception as e:
234:                 print(f"Error with new mediapipe API: {e}")
235:                 return np.zeros(478 * 3)  # 478 landmarks * 3 coordinates
236:         elif self.face_mesh:
237:             # Handle older solutions API
238:             results = self.face_mesh.process(frame)
239:             
240:             if results.multi_face_landmarks:
241:                 landmarks = results.multi_face_landmarks[0]
242:                 landmark_array = np.array([
243:                     [lm.x, lm.y, lm.z] for lm in landmarks.landmark
244:                 ])
245:                 # Flatten and normalize
246:                 return landmark_array.flatten()
247:             else:
248:                 # Return zeros if no face detected (could indicate manipulation)
249:                 return np.zeros(478 * 3)  # 478 landmarks * 3 coordinates
250:         else:
251:             # Return zeros if no mediapipe implementation is available
252:             return np.zeros(478 * 3)  # 478 landmarks * 3 coordinates
253:     
254:     def extract_motion_features(self, frame: np.ndarray) -> np.ndarray:
255:         """Extract motion features from frame"""
256:         try:
257:             # Convert to grayscale
258:             gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
259:             
260:             # Simple motion features: edges, corners, etc.
261:             edges = cv2.Canny(gray, 50, 150)
262:             corners = cv2.goodFeaturesToTrack(edges, maxCorners=100, qualityLevel=0.01, minDistance=10)
263:             
264:             corner_count = len(corners) if corners is not None else 0
265:             edge_density = np.sum(edges > 0) / (edges.shape[0] * edges.shape[1])
266:             
267:             return np.array([corner_count, edge_density])
268:         except Exception as e:
269:             print(f"Error extracting motion features: {e}")
270:             return np.array([0, 0])  # Return fallback values
271: 
272: 
273: class MotionAnalyzer:
274:     """Analyze motion patterns for deepfake detection"""
275:     
276:     def __init__(self):
277:         self.prev_gray = None
278:         self.flow_threshold = 0.1
279:     
280:     def analyze_motion_consistency(self, frame: np.ndarray) -> Dict[str, float]:
281:         """Analyze motion consistency between frames"""
282:         gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
283:         
284:         if self.prev_gray is not None:
285:             # Calculate optical flow
286:             flow = cv2.calcOpticalFlowFarneback(
287:                 self.prev_gray, gray, None, 
288:                 0.5, 3, 15, 3, 5, 1.2, 0
289:             )
290:             
291:             # Calculate motion statistics
292:             magnitude, angle = cv2.cartToPolar(flow[..., 0], flow[..., 1])
293:             avg_magnitude = np.mean(magnitude)
294:             std_magnitude = np.std(magnitude)
295:             
296:             self.prev_gray = gray
297:             return {
298:                 'avg_magnitude': avg_magnitude,
299:                 'std_magnitude': std_magnitude,
300:                 'flow_consistency': 1.0 / (1.0 + std_magnitude)  # Higher std = less consistent
301:             }
302:         else:
303:             self.prev_gray = gray
304:             return {'avg_magnitude': 0.0, 'std_magnitude': 0.0, 'flow_consistency': 1.0}
305: 
