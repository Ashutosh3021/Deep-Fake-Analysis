42: Finding = Dict[str, Any]
43: 
44: 
45: def make_finding(signal: str, score: float, description: str,
46:                   region: Optional[Tuple[int, int, int, int]] = None) -> Finding:
47:     return {
48:         "signal": signal,
49:         "score": round(float(np.clip(score, 0.0, 1.0)), 3),
50:         "region": region,
