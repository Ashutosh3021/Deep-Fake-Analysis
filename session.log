46: PRIMARY_MODEL_ID = os.getenv("IMAGE_DETECTOR_MODEL", "umm-maybe/AI-image-detector")
47: 
48: # Per-family thresholds. A family "fires" (contributes to a FAKE verdict)
49: # if its score exceeds this. These are intentionally distinct from the
50: # 0.5 used for a coin-flip-style global score, because each family here
51: # is asking a more specific question ("is there a localized anomaly") and
52: # can be more conservative individually while still being decisive when
53: # it does fire.
54: GLOBAL_MODEL_FIRE_THRESHOLD = 0.55
55: SPLICE_FIRE_THRESHOLD = 0.45
56: FACE_SWAP_FIRE_THRESHOLD = 0.45
