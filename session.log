169:             results = self._face_mesh.process(rgb)
170:             if results.multi_face_landmarks:
171:                 # Track the largest/first face for the temporal sequence.
172:                 # (Per-face temporal tracking across multiple people is a
173:                 # natural extension but needs identity association across
174:                 # frames, which is out of scope for this lightweight pass.)
175:                 lm = results.multi_face_landmarks[0].landmark
176:                 pts = np.array([[p.x, p.y, p.z] for p in lm])
177:                 sequence.append(pts)
178:             else:
