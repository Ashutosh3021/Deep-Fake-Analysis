91: class FinalAudioDetector:
92:     def __init__(self):
93:         self._hf_pipeline = None
94:         self._hf_load_error: Optional[str] = None
95:         self._trained_classifier = None
96:         self._classifier_load_error: Optional[str] = None
97: 
98:         self._try_load_trained_classifier()
99:         self._try_load_pretrained_model()
100: 
101:     # ------------------------------------------------------------------
102:     def _try_load_trained_classifier(self):
103:         if os.path.exists(AUDIO_CLASSIFIER_PATH):
104:             try:
105:                 with open(AUDIO_CLASSIFIER_PATH, "rb") as f:
106:                     self._trained_classifier = pickle.load(f)
107:                 logger.info("Loaded trained audio classifier from %s", AUDIO_CLASSIFIER_PATH)
108:             except Exception as e:
109:                 self._classifier_load_error = str(e)
110:                 logger.warning("Failed to load trained classifier: %s", e)
111: 
112:     def _try_load_pretrained_model(self):
113:         try:
114:             from transformers import pipeline
115:             self._hf_pipeline = pipeline("audio-classification", model=PRETRAINED_MODEL_ID)
116:             logger.info("Loaded pretrained audio spoof-detection model: %s", PRETRAINED_MODEL_ID)
117:         except Exception as e:
118:             self._hf_load_error = str(e)
119:             logger.warning(
120:                 "Could not load pretrained HF audio model (%s). "
121:                 "Will fall back to acoustic-heuristic mode.", e
122:             )
123: 
124:     # ------------------------------------------------------------------
125:     # Acoustic feature extraction (real, physically grounded)
126:     # ------------------------------------------------------------------
127:     def extract_training_features(self, audio_path: str) -> Optional[np.ndarray]:
128:         """
129:         Extracts a fixed-length feature vector suitable both for live
130:         inference AND for training Strategy B's classifier offline.
131:         Keeping this single shared function means train-time and
132:         inference-time features can never silently drift apart.
133:         """
134:         try:
135:             audio, sr = librosa.load(audio_path, sr=SAMPLE_RATE, mono=True)
136:             if len(audio) < sr * 0.3:  # less than 300ms is not analyzable
137:                 return None
138: 
139:             feats: List[float] = []
140: 
141:             # --- Spectral shape ---
142:             feats.append(float(np.mean(librosa.feature.spectral_centroid(y=audio, sr=sr))))
143:             feats.append(float(np.mean(librosa.feature.spectral_bandwidth(y=audio, sr=sr))))
144:             feats.append(float(np.mean(librosa.feature.spectral_rolloff(y=audio, sr=sr))))
145:             feats.append(float(np.mean(librosa.feature.spectral_flatness(y=audio))))
146:             feats.append(float(np.mean(librosa.feature.zero_crossing_rate(audio))))
147: 
148:             # --- MFCC (timbre) ---
149:             mfccs = librosa.feature.mfcc(y=audio, sr=sr, n_mfcc=20)
150:             feats.extend(np.mean(mfccs, axis=1).tolist())
151:             feats.extend(np.std(mfccs, axis=1).tolist())
152: 
153:             # --- Harmonic / percussive balance ---
154:             harmonic, percussive = librosa.effects.hpss(audio)
155:             harmonic_ratio = float(np.sum(harmonic ** 2) / (np.sum(audio ** 2) + 1e-8))
156:             feats.append(harmonic_ratio)
157: 
158:             # --- F0 stability, jitter (TTS/VC often has unnaturally
159:             #     stable or erratic pitch contours vs. human speech) ---
160:             f0, voiced_flag, _ = librosa.pyin(
161:                 audio, fmin=librosa.note_to_hz("C2"), fmax=librosa.note_to_hz("C7")
162:             )
163:             if f0 is not None and np.any(voiced_flag):
164:                 f0_voiced = f0[voiced_flag]
165:                 f0_mean = float(np.nanmean(f0_voiced))
166:                 f0_std = float(np.nanstd(f0_voiced))
167:                 if len(f0_voiced) > 1 and f0_mean > 0:
168:                     jitter = float(np.mean(np.abs(np.diff(f0_voiced))) / f0_mean)
169:                 else:
170:                     jitter = 0.0
171:             else:
172:                 f0_mean, f0_std, jitter = 0.0, 0.0, 0.0
173:             feats.extend([f0_mean, f0_std, jitter])
174: 
175:             # --- Phase coherence (vocoder artifacts often disrupt natural
176:             #     phase relationships between adjacent frames) ---
177:             stft = librosa.stft(audio)
178:             phase = np.angle(stft)
179:             phase_diff = np.diff(phase, axis=1)
180:             phase_discontinuity = float(np.mean(np.abs(phase_diff) > np.pi / 4))
181:             feats.append(phase_discontinuity)
182: 
183:             # --- Distributional shape of the waveform itself ---
184:             feats.append(float(skew(audio)))
185:             feats.append(float(kurtosis(audio)))
186: 
187:             return np.array(feats, dtype=np.float32)
188:         except Exception as e:
189:             logger.error("Feature extraction failed for %s: %s", audio_path, e)
190:             return None
191: 
192:     # ------------------------------------------------------------------
193:     # Strategy A: pretrained HF model
194:     # ------------------------------------------------------------------
195:     def _hf_predict(self, audio_path: str) -> Optional[float]:
196:         if self._hf_pipeline is None:
197:             return None
198:         try:
199:             results = self._hf_pipeline(audio_path)
200:             fake_score = 0.0
201:             for r in results:
202:                 label = r["label"].lower()
203:                 if any(k in label for k in ("fake", "spoof", "synthetic", "generated")):
204:                     fake_score = max(fake_score, r["score"])
205:                 elif any(k in label for k in ("real", "bonafide", "genuine", "human")):
206:                     fake_score = max(fake_score, 1.0 - r["score"])
207:             return float(fake_score)
208:         except Exception as e:
209:             logger.error("HF audio model inference failed: %s", e)
210:             return None
211: 
212:     # ------------------------------------------------------------------
213:     # Strategy B: your trained classifier on acoustic features
214:     # ------------------------------------------------------------------
215:     def _trained_classifier_predict(self, audio_path: str) -> Optional[float]:
216:         if self._trained_classifier is None:
217:             return None
218:         feats = self.extract_training_features(audio_path)
219:         if feats is None:
220:             return None
221:         try:
222:             proba = self._trained_classifier.predict_proba(feats.reshape(1, -1))[0]
223:             # Assumes class index 1 == "fake/spoof" -- match this to however
224:             # you label y during training (see train_from_dataset below).
225:             return float(proba[1])
226:         except Exception as e:
227:             logger.error("Trained classifier inference failed: %s", e)
228:             return None
229: 
230:     # ------------------------------------------------------------------
231:     # Heuristic fallback (used only if neither A nor B is available)
232:     # ------------------------------------------------------------------
233:     def _heuristic_predict(self, audio_path: str) -> float:
234:         """
235:         Last-resort signal using domain knowledge but no fitted classifier.
236:         This is intentionally conservative -- it should rarely push the
237:         score far from 0.5 unless multiple indicators agree, because
238:         unfit thresholds are guesses, not measurements.
239:         """
240:         feats = self.extract_training_features(audio_path)
241:         if feats is None:
242:             return 0.5
243: 
244:         # Indices match extract_training_features() ordering:
245:         # [centroid, bandwidth, rolloff, flatness, zcr, mfcc_mean(20),
246:         #  mfcc_std(20), harmonic_ratio, f0_mean, f0_std, jitter,
247:         #  phase_discontinuity, skew, kurtosis]
248:         flatness = feats[3]
249:         harmonic_ratio = feats[45]
250:         jitter = feats[48]
251:         phase_discontinuity = feats[49]
252: 
253:         indicators = []
254:         # Real speech is rarely spectrally flat; very flat -> synthetic-leaning.
255:         indicators.append(np.clip(flatness / 0.05, 0, 1))
256:         # Very low jitter (too-perfect pitch) suggests synthesis.
257:         indicators.append(1.0 - np.clip(jitter / 0.02, 0, 1)) if jitter > 0 else indicators.append(0.5)
258:         # High phase discontinuity suggests vocoder artifacts.
259:         indicators.append(np.clip(phase_discontinuity / 0.4, 0, 1))
260: 
261:         return float(np.clip(np.mean(indicators), 0.0, 1.0))
262: 
263:     # ------------------------------------------------------------------
264:     # Public API
265:     # ------------------------------------------------------------------
266:     def predict(self, audio_path: str) -> Dict[str, Any]:
267:         if not os.path.exists(audio_path):
268:             return {"error": "file_not_found", "path": audio_path}
269: 
270:         # Preference order: your trained classifier > pretrained HF model
271:         # > heuristic fallback. Trained-on-your-data always wins if present.
272:         score = self._trained_classifier_predict(audio_path)
273:         source = "trained_classifier"
274: 
275:         if score is None:
276:             score = self._hf_predict(audio_path)
277:             source = "pretrained_hf_model"
278: 
279:         if score is None:
280:             score = self._heuristic_predict(audio_path)
281:             source = "heuristic_fallback"
282: 
283:         fake_probability = float(np.clip(score, 0.0, 1.0))
284:         distance_from_mid = abs(fake_probability - 0.5) * 2
285: 
286:         if source == "heuristic_fallback":
287:             # Be explicit: this mode has a much lower ceiling. Halve the
288:             # effective certainty rather than report a number people might
289:             # trust as much as a real model's output.
290:             distance_from_mid *= 0.5
291: 
292:         if distance_from_mid < (1 - LOW_CONFIDENCE_THRESHOLD):
293:             label = "UNCERTAIN"
294:         elif fake_probability > 0.5:
295:             label = "SYNTHETIC"
296:         else:
297:             label = "AUTHENTIC"
298: 
299:         confidence = 50.0 + distance_from_mid * 50.0
300: 
301:         notes_map = {
302:             "trained_classifier": "Score from classifier trained on your labeled dataset.",
303:             "pretrained_hf_model": f"Score from pretrained model ({PRETRAINED_MODEL_ID}).",
304:             "heuristic_fallback": (
305:                 "No trained classifier or pretrained model available -- running on "
306:                 "unfit acoustic heuristics. Confidence is deliberately suppressed. "
307:                 "Train Strategy B (see file docstring) for real accuracy."
308:             ),
309:         }
310: 
311:         verdict = AudioVerdict(
312:             label=label,
313:             confidence=confidence,
314:             fake_probability=fake_probability,
315:             signal_source=source,
316:             feature_summary={"raw_score": round(score, 4)},
317:             notes=notes_map[source],
318:         )
319:         return verdict.to_dict()
320: 
