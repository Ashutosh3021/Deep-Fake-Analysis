150:     # ------------------------------------------------------------------
151:     # Temporal / geometric consistency (swap-agnostic, video-only signal)
152:     # ------------------------------------------------------------------
153:     @staticmethod
154:     def _eye_aspect_ratio(pts: np.ndarray, eye_indices: List[int]) -> float:
155:         p = pts[eye_indices]
156:         vertical1 = np.linalg.norm(p[1] - p[5])
157:         vertical2 = np.linalg.norm(p[2] - p[4])
158:         horizontal = np.linalg.norm(p[0] - p[3])
159:         if horizontal < 1e-6:
160:             return 0.3
161:         return (vertical1 + vertical2) / (2.0 * horizontal)
