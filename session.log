46: import numpy as np
47: 
48: warnings.filterwarnings("ignore")
49: logger = logging.getLogger(__name__)
50: 
51: PROBE_MODEL_ID = os.getenv("TEXT_DETECTOR_PROBE_MODEL", "gpt2")
52: MIN_WORDS_FOR_RELIABLE_SCORE = 50
53: LOW_CONFIDENCE_THRESHOLD = 0.58
54: 
55: # Perplexity / burstiness weight vs. stylistic-pattern weight. Perplexity
56: # is the real signal; patterns are corroborating only and explicitly
57: # capped in influence to avoid penalizing legitimate formal writing.
58: PERPLEXITY_WEIGHT = 0.75
59: PATTERN_WEIGHT = 0.25
60: 
61: 
62: @dataclass
63: class TextVerdict:
