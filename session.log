14: // DeepGuard AI Dashboard JavaScript
15: class DeepGuardDashboard {
16:     constructor() {
17:         this.history = JSON.parse(localStorage.getItem('deepguard_history')) || [];
18:         this.apiBaseUrl = 'http://localhost:5000';
19:         this.init();
20:     }
21: 
22:     init() {
23:         this.bindEvents();
24:         this.updateStats();
25:         this.renderHistory();
26:         this.checkApiStatus();
27:     }
28: 
29:     bindEvents() {
30:         // Tab navigation
31:         document.querySelectorAll('.nav-btn').forEach(btn => {
32:             btn.addEventListener('click', (e) => this.switchTab(e.target.dataset.tab));
33:         });
34: 
35:         // File upload
36:         const uploadArea = document.getElementById('upload-area');
37:         const fileInput = document.getElementById('file-input');
38: 
39:         uploadArea.addEventListener('click', () => fileInput.click());
40:         uploadArea.addEventListener('dragover', (e) => this.handleDragOver(e));
41:         uploadArea.addEventListener('dragleave', (e) => this.handleDragLeave(e));
42:         uploadArea.addEventListener('drop', (e) => this.handleDrop(e));
43:         fileInput.addEventListener('change', (e) => this.handleFileSelect(e));
44: 
45:         // Text analysis
46:         document.getElementById('analyze-text-btn').addEventListener('click', () => this.analyzeText());
47: 
48:         // Clear history
49:         document.getElementById('clear-history').addEventListener('click', () => this.clearHistory());
50:     }
51: 
52:     switchTab(tabId) {
53:         // Update nav buttons
54:         document.querySelectorAll('.nav-btn').forEach(btn => {
55:             btn.classList.toggle('active', btn.dataset.tab === tabId);
56:         });
57: 
58:         // Update tab content
59:         document.querySelectorAll('.tab-content').forEach(content => {
60:             content.classList.toggle('active', content.id === tabId);
61:         });
62:     }
63: 
64:     handleDragOver(e) {
65:         e.preventDefault();
66:         e.currentTarget.classList.add('dragover');
67:     }
68: 
69:     handleDragLeave(e) {
70:         e.currentTarget.classList.remove('dragover');
71:     }
72: 
73:     handleDrop(e) {
74:         e.preventDefault();
75:         e.currentTarget.classList.remove('dragover');
76: 
77:         const files = e.dataTransfer.files;
78:         if (files.length > 0) {
79:             this.processFile(files[0]);
80:         }
81:     }
82: 
83:     handleFileSelect(e) {
84:         const file = e.target.files[0];
85:         if (file) {
86:             this.processFile(file);
87:         }
88:     }
89: 
90:     async processFile(file) {
91:         this.showLoading(true);
92: 
93:         const formData = new FormData();
94:         formData.append('file', file);
95: 
96:         try {
97:             const response = await fetch(`${this.apiBaseUrl}/api/detect/auto`, {
98:                 method: 'POST',
99:                 body: formData
100:             });
101: 
102:             if (!response.ok) {
103:                 throw new Error(`HTTP error! status: ${response.status}`);
104:             }
105: 
106:             const data = await response.json();
107: 
108:             if (data.success) {
109:                 this.displayResults(data.result, file.name, data.file_type);
110:                 this.addToHistory(file.name, data.file_type, data.result);
111:             } else {
112:                 throw new Error(data.error || 'Analysis failed');
113:             }
114:         } catch (error) {
115:             console.error('Error:', error);
116:             // Fallback to mock results for demo
117:             this.displayMockResults(file.name, this.getFileType(file.name));
118:         } finally {
119:             this.showLoading(false);
120:         }
121:     }
122: 
123:     async analyzeText() {
