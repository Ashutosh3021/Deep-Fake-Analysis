132:         global_findings = forensics["global_findings"]
133:         global_heuristic_score = float(np.mean([f["score"] for f in global_findings]))
134:         if model_signal is not None:
135:             global_score = 0.7 * model_signal + 0.3 * global_heuristic_score
136:         else:
137:             global_score = global_heuristic_score
138: 
139:         # --- Family B: localized AI-edit / splice ---
140:         splice_findings = forensics["splice_findings"]
141:         splice_score = float(np.max([f["score"] for f in splice_findings])) if splice_findings else 0.0
142: 
143:         # --- Family C: face-swap (max across all detected faces -- one
144:         #     fake face among several real ones should still trigger) ---
145:         face_analyses = forensics["face_analyses"]
146:         face_swap_score = float(np.max([fa["face_swap_score"] for fa in face_analyses])) if face_analyses else 0.0
147: 
148:         fired_families = []
149:         reasons: List[Dict[str, Any]] = []
150: 
151:         if global_score >= GLOBAL_MODEL_FIRE_THRESHOLD:
152:             fired_families.append("fully_ai_generated")
153:             if model_signal is not None and model_signal >= GLOBAL_MODEL_FIRE_THRESHOLD:
154:                 reasons.append({
155:                     "signal": "pretrained_classifier", "score": round(model_signal, 3),
156:                     "region": None,
157:                     "description": "Pretrained AI-image classifier scored this image as likely AI-generated."
158:                 })
159:             for f in global_findings:
160:                 if f["score"] >= 0.5:
161:                     reasons.append(f)
162: 
163:         if splice_score >= SPLICE_FIRE_THRESHOLD:
164:             fired_families.append("ai_edited_region")
165:             for f in splice_findings:
