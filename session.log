1: function escapeHTML(str) {
2:     if (typeof str !== 'string') return str;
3:     return str.replace(/[&<>'"]/g,
4:         tag => ({
5:             '&': '&amp;',
6:             '<': '&lt;',
7:             '>': '&gt;',
8:             "'": '&#39;',
9:             '"': '&quot;'
10:         }[tag] || tag)
11:     );
12: }
