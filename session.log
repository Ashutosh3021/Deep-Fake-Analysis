84: class FinalImageDetector:
85:     def __init__(self, lite_mode: bool = False):
86:         self.lite_mode = lite_mode
87:         self._pipeline = None
88:         self._model_load_error: Optional[str] = None
89:         if not lite_mode:
90:             self._load_model()
91: 
92:     def _load_model(self):
93:         try:
94:             from transformers import pipeline
95:             self._pipeline = pipeline("image-classification", model=PRIMARY_MODEL_ID)
96:             logger.info("Loaded primary image detection model: %s", PRIMARY_MODEL_ID)
97:         except Exception as e:
