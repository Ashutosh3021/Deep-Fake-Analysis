180:         return sequence
181: 
182:     def _temporal_analysis(self, frames: List[np.ndarray], fps: float) -> Dict[str, Any]:
183:         if self._face_mesh is None:
184:             return {"available": False, "reason": "mediapipe not installed", "score": 0.0}
185: 
186:         sequence = self._landmark_sequence(frames)
